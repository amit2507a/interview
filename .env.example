# ─── AWS ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ─── Bedrock ─────────────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REGION=us-east-1

# ─── Database ─────────────────────────────────────
DATABASE_URL=postgresql://interview_user:password@localhost:5432/interview_db

# ─── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── S3 ───────────────────────────────────────────
S3_BUCKET_NAME=interview-videos-mvp
S3_REGION=us-east-1

# ─── SQS ──────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT/interview-jobs
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT/interview-jobs-dlq

# ─── Auth ─────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Optional: use Cognito instead
# COGNITO_USER_POOL_ID=us-east-1_xxxxx
# COGNITO_CLIENT_ID=xxxxxxxxx

# ─── API Ports ────────────────────────────────────
API_PORT=4000
AI_SERVICE_PORT=8000

# ─── Frontend ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── OpenAI / Whisper (fallback STT) ─────────────
OPENAI_API_KEY=sk-...

# ─── Environment ─────────────────────────────────
NODE_ENV=development
